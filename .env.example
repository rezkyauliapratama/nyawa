# Nyawa reads these values from the process environment; it does not load .env
# files itself. Keep real API keys in a secret manager or service environment.
#
# Default / backward-compatible memory mode: local BGE ONNX (384 dimensions).
# Leave this unset or set it to local to preserve an existing BGE/384 HNSW index.
MEMORY_EMBEDDER=local

# Optional local BGE model override.
# NYAWA_EMBED_MODEL_DIR=/opt/data/bge-models/minilm-multilingual

# API mode is opt-in. Set MEMORY_EMBEDDER=api only for a new/rebuilt index
# produced entirely by this API model. It does not fall back to BGE or Ollama.
# MEMORY_EMBEDDER=api
# EMBEDDING_API_KEY=inject-from-secret-manager
# EMBEDDING_BASE_URL=https://api.jina.ai/v1
# EMBEDDING_MODEL=jina-embeddings-v3
# EMBEDDING_DIMS=1024

# RAG has its own selector and vector index. Default: local BGE/384.
# Set api to use the OpenAI-compatible embedder in a separate RAG HNSW index.
RAG_EMBEDDER=local
# RAG_EMBEDDER=api
# Retrieval task capability: auto (default; only Jina v3 endpoint/model), none,
# or jina-v3 (explicit opt-in for a compatible proxy/custom endpoint).
RAG_EMBEDDING_TASK_MODE=auto
